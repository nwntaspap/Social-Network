# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_ENVIRONMENT=development
SERVER_TLS_CERT_FILE=certs/localhost+2.pem
SERVER_TLS_KEY_FILE=certs/localhost+2-key.pem

# Client Configuration
CLIENT_HOST=localhost
CLIENT_PORT=3000
CLIENT_ENVIRONMENT=development
CLIENT_TLS_CERT_FILE=certs/localhost+2.pem
CLIENT_TLS_KEY_FILE=certs/localhost+2-key.pem
BACKEND_URL=https://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE=https://localhost:8080

# Database Configuration
DB_DRIVER=sqlite3
DB_PATH=db/data/forum.db
DB_MIGRATE_ON_START=true
DB_SEED_ON_START=true
DB_PRAGMA=_foreign_keys=on&_journal_mode=WAL&_busy_timeout=5000

# Session & Security
SESSION_SECURE_COOKIE=true
SESSION_COOKIE_SAME_SITE=Lax
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Allowed Origins
ALLOWED_ORIGINS=https://localhost:8080,http://localhost:3001,

# Notifications Service
NOTIFICATIONS_HOST=0.0.0.0
NOTIFICATIONS_PORT=8081
NOTIFICATIONS_BACKEND_URL=https://localhost:8080/api/v1
NOTIFICATIONS_ALLOWED_ORIGINS=http://localhost:3001
NOTIFICATIONS_READ_TIMEOUT=10
NOTIFICATIONS_WRITE_TIMEOUT=20
NOTIFICATIONS_IDLE_TIMEOUT=30
NOTIFICATIONS_DB_PATH=db/data/notifications.db

# Message broker (used by both the forum eventbus and the notifications consumer)
NOTIFICATIONS_BROKER_URL=localhost:5672
