# ── Server Configuration ──────────────────────────────────────────────
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_ENVIRONMENT=development
SERVER_API_CONTEXT_V1=/api/v1
SERVER_READ_TIMEOUT=5
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=15
SERVER_TLS_CERT_FILE=certs/localhost+2.pem
SERVER_TLS_KEY_FILE=certs/localhost+2-key.pem

# ── Database Configuration ───────────────────────────────────────────
DB_DRIVER=sqlite3
DB_PATH=db/data/forum.db
DB_MIGRATE_ON_START=true
DB_SEED_ON_START=true
DB_PRAGMA=_foreign_keys=on&_journal_mode=WAL&_busy_timeout=5000
DB_OPEN_CONN=1

# ── Session & Security ───────────────────────────────────────────────
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax
SESSION_HTTPONLY_COOKIE=true
SESSION_DEFAULT_EXPIRY=86400
SESSION_REFRESH_TOKEN_EXPIRY=30
SESSION_ACCESS_COOKIE_NAME=access_token
SESSION_REFRESH_COOKIE_NAME=refresh_token
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_CLEANUP_INTERVAL=3600
SESSION_MAX_SESSIONS_PER_USER=5
SESSION_ID_LENGTH=32
SESSION_ENABLE_PERSISTENCE=true
SESSION_LOG_SESSIONS=false

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CLEANUP_SECONDS=60

# ── Handler Timeouts (seconds) ──────────────────────────────────────
HANDLER_TIMEOUT_REGISTER=15
HANDLER_TIMEOUT_LOGIN=15

# ── Allowed Origins ──────────────────────────────────────────────────
ALLOWED_ORIGINS=https://localhost:8080,http://localhost:3001

# ── OAuth (GitHub) ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3001/api/v1/auth/oauth/github/callback
GITHUB_SCOPES=user:email
FRONTEND_GITHUB_CALLBACK_URL=http://localhost:3001/auth/callback

# ── OAuth (Google) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3001/api/v1/auth/oauth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/userinfo.profile,https://www.googleapis.com/auth/userinfo.email
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:3001/auth/callback

# ── Notifications Service ────────────────────────────────────────────
# Empty in Docker (Next proxy works server-side).  Set to http://localhost:8081
# for native dev: the proxy buffers text/event-stream frames indefinitely, so
# the frontend dials the service directly while cookies travel cross-port.
NEXT_PUBLIC_NOTIFICATIONS_ORIGIN=

# ── Message Broker ───────────────────────────────────────────────────
# Used by both the forum eventbus and the notifications consumer
NOTIFICATIONS_BROKER_URL=localhost:5672
